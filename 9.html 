<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>HCI Logo 3D效果 | SVG立体化</title>
  <style>
    body {
      margin: 0;
      overflow: hidden;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    #info {
      position: absolute;
      bottom: 20px;
      left: 20px;
      color: rgba(255, 255, 255, 0.8);
      background: rgba(0, 0, 0, 0.6);
      padding: 8px 20px;
      border-radius: 30px;
      font-size: 14px;
      letter-spacing: 1px;
      backdrop-filter: blur(10px);
      pointer-events: none;
      box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }
    .instruction {
      position: absolute;
      bottom: 20px;
      right: 20px;
      color: rgba(255, 255, 255, 0.7);
      background: rgba(0, 0, 0, 0.5);
      padding: 6px 18px;
      border-radius: 20px;
      font-size: 13px;
      backdrop-filter: blur(8px);
      pointer-events: none;
    }
    canvas {
      display: block;
    }
  </style>
</head>
<body>
  <div id="info">✨ HCI LOGO · 3D 立体效果</div>
  <div class="instruction">🖱️ 鼠标拖动旋转视角 | 📜 滚轮缩放 | ✨ 右键平移</div>

  <!-- 引入 Three.js 核心库以及扩展 -->
  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.128.0/build/three.module.js",
        "three/addons/": "https://unpkg.com/three@0.128.0/examples/jsm/"
      }
    }
  </script>

  <script type="module">
    import * as THREE from 'three';
    import { OrbitControls } from 'three/addons/controls/OrbitControls.js';
    import { SVGLoader } from 'three/addons/loaders/SVGLoader.js';
    import { CSS2DRenderer, CSS2DObject } from 'three/addons/renderers/CSS2DRenderer.js';

    // ---------- 初始化场景、相机、渲染器 ----------
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a0a14); // 深邃的深蓝紫色背景
    
    // 添加一些微妙的星星效果（使用粒子系统增强空间感）
    const starsGeometry = new THREE.BufferGeometry();
    const starsCount = 800;
    const starsPositions = new Float32Array(starsCount * 3);
    for (let i = 0; i < starsCount * 3; i += 3) {
      starsPositions[i] = (Math.random() - 0.5) * 40;
      starsPositions[i+1] = (Math.random() - 0.5) * 25;
      starsPositions[i+2] = (Math.random() - 0.5) * 20;
    }
    starsGeometry.setAttribute('position', new THREE.BufferAttribute(starsPositions, 3));
    const starsMaterial = new THREE.PointsMaterial({
      color: 0xaaccff,
      size: 0.03,
      blending: THREE.AdditiveBlending,
      depthWrite: false
    });
    const stars = new THREE.Points(starsGeometry, starsMaterial);
    scene.add(stars);

    // 主相机：透视相机
    const camera = new THREE.PerspectiveCamera(45, window.innerWidth / window.innerHeight, 0.1, 100);
    camera.position.set(4, 2.5, 6);
    camera.lookAt(0, 0, 0);

    // WebGL渲染器
    const renderer = new THREE.WebGLRenderer({ 
      antialias: true,
      alpha: false 
    });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // 限制极高像素比以防性能问题
    renderer.shadowMap.enabled = true; // 开启阴影以获得更好立体感
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.setClearColor(0x0a0a14);
    document.body.appendChild(renderer.domElement);

    // 辅助CSS2渲染器用于显示文字标签（可选，这里用来增加一个装饰标签）
    const labelRenderer = new CSS2DRenderer();
    labelRenderer.setSize(window.innerWidth, window.innerHeight);
    labelRenderer.domElement.style.position = 'absolute';
    labelRenderer.domElement.style.top = '0px';
    labelRenderer.domElement.style.left = '0px';
    labelRenderer.domElement.style.pointerEvents = 'none'; // 让点击穿透到画布
    document.body.appendChild(labelRenderer.domElement);

    // 控制器
    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.dampingFactor = 0.05;
    controls.rotateSpeed = 0.8;
    controls.zoomSpeed = 1.2;
    controls.panSpeed = 0.7;
    controls.target.set(0, 0.2, 0);
    controls.update();
    controls.maxPolarAngle = Math.PI; // 允许到下方观看
    controls.minDistance = 3.0;
    controls.maxDistance = 15.0;

    // ---------- 灯光设置（打造立体金属质感） ----------
    // 环境光提供基础亮度
    const ambientLight = new THREE.AmbientLight(0x404066);
    scene.add(ambientLight);
    
    // 主光源方向光，产生明暗对比
    const keyLight = new THREE.DirectionalLight(0xffeedd, 1.2);
    keyLight.position.set(5, 8, 5);
    keyLight.castShadow = true;
    keyLight.receiveShadow = true;
    keyLight.shadow.mapSize.width = 1024;
    keyLight.shadow.mapSize.height = 1024;
    keyLight.shadow.camera.near = 0.5;
    keyLight.shadow.camera.far = 30;
    keyLight.shadow.camera.left = -7;
    keyLight.shadow.camera.right = 7;
    keyLight.shadow.camera.top = 7;
    keyLight.shadow.camera.bottom = -4;
    keyLight.shadow.bias = -0.0001;
    keyLight.shadow.normalBias = 0.02;
    scene.add(keyLight);
    
    // 辅助彩色灯光，增加科技感和立体层次
    const blueLight = new THREE.PointLight(0x4466ff, 0.9, 12);
    blueLight.position.set(-3, 1, 3);
    blueLight.castShadow = true;
    blueLight.shadow.mapSize.width = 512;
    blueLight.shadow.mapSize.height = 512;
    scene.add(blueLight);
    
    const purpleLight = new THREE.PointLight(0xaa44ff, 0.7, 10);
    purpleLight.position.set(2, -1.5, -3);
    purpleLight.castShadow = true;
    purpleLight.shadow.mapSize.width = 512;
    purpleLight.shadow.mapSize.height = 512;
    scene.add(purpleLight);
    
    // 背面补光，勾勒边缘
    const backLight = new THREE.DirectionalLight(0x335577, 0.8);
    backLight.position.set(-3, 0, -4);
    scene.add(backLight);

    // 一个微弱的顶部光
    const topLight = new THREE.PointLight(0x88aaff, 0.5, 8);
    topLight.position.set(0, 4, 0);
    scene.add(topLight);

    // ---------- 辅助地面/反射效果（半透明平面接收阴影，增强立体感） ----------
    const groundGeometry = new THREE.CircleGeometry(3.5, 64);
    const groundMaterial = new THREE.MeshPhongMaterial({ 
      color: 0x1a1a3a, 
      emissive: new THREE.Color(0x050514),
      shininess: 30,
      transparent: true,
      opacity: 0.25,
      side: THREE.DoubleSide
    });
    const ground = new THREE.Mesh(groundGeometry, groundMaterial);
    ground.rotation.x = -Math.PI / 2;
    ground.position.y = -1.4;
    ground.receiveShadow = true;
    ground.castShadow = false;
    scene.add(ground);
    
    // 添加一个微妙的网格线环，增强空间参考
    const ringGeometry = new THREE.TorusGeometry(2.2, 0.02, 32, 100);
    const ringMaterial = new THREE.MeshStandardMaterial({ 
      color: 0x6688cc, 
      emissive: new THREE.Color(0x112244),
      roughness: 0.4,
      metalness: 0.7
    });
    const ring = new THREE.Mesh(ringGeometry, ringMaterial);
    ring.rotation.x = Math.PI / 2;
    ring.position.y = -1.38;
    ring.receiveShadow = true;
    scene.add(ring);

    // ---------- 核心：加载SVG并转换为3D立体模型 ----------
    const loader = new SVGLoader();
    // 直接使用提供的HCI logo URL
    const svgUrl = 'https://hci.cn/hci-logo.svg';
    
    // 存储生成的模型组，以便后续可能的操作
    const logoGroup = new THREE.Group();
    logoGroup.position.set(0, 0.15, 0);
    
    // 加载SVG
    loader.load(svgUrl, 
      (data) => {
        // data 包含 paths 信息
        const paths = data.paths;
        
        // 遍历所有路径
        paths.forEach((path, index) => {
          const shapes = SVGLoader.createShapes(path);
          
          // 每个路径可能包含多个形状
          shapes.forEach((shape, shapeIndex) => {
            // 使用ExtrudeGeometry将2D形状拉伸为3D立体
            const extrudeSettings = {
              steps: 2,               // 分段数，保持边缘清晰
              depth: 0.45,           // 拉伸深度，形成厚度
              bevelEnabled: true,    // 启用倒角
              bevelThickness: 0.08,  // 倒角厚度
              bevelSize: 0.04,       // 倒角大小
              bevelSegments: 5       // 倒角分段，使边缘圆滑
            };
            
            const geometry = new THREE.ExtrudeGeometry(shape, extrudeSettings);
            
            // 居中几何体，因为SVG路径可能偏移
            geometry.computeBoundingBox();
            const box = geometry.boundingBox;
            if (box) {
              const centerX = (box.max.x + box.min.x) / 2;
              const centerY = (box.max.y + box.min.y) / 2;
              // 在X和Y方向居中，Z方向不需要移动（深度从0开始）
              geometry.translate(-centerX, -centerY, 0);
            }
            
            // 创建材质：使用金属质感，带有颜色渐变效果
            // 根据路径索引和形状索引变化颜色，但保持整体HCI风格（蓝紫色调）
            const hue = 0.62 + (index * 0.03) % 0.15; // 蓝紫色范围
            const color = new THREE.Color().setHSL(hue, 0.8, 0.6);
            
            const material = new THREE.MeshStandardMaterial({
              color: color,
              roughness: 0.28,
              metalness: 0.75,
              emissive: new THREE.Color(0x111133),
              emissiveIntensity: 0.25,
              flatShading: false,
              side: THREE.DoubleSide // 双面渲染，以便看到内部结构（如果相机穿入）
            });
            
            const mesh = new THREE.Mesh(geometry, material);
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            
            // 轻微调整每个形状的位置，避免重叠（实际上SVG形状本身已定位）
            // 但为了安全，保持原始位置
            
            logoGroup.add(mesh);
            
            // 添加边缘线框，增强立体视觉
            const wireframeMaterial = new THREE.MeshBasicMaterial({
              color: 0xaaccff,
              wireframe: true,
              transparent: true,
              opacity: 0.15
            });
            const wireframeMesh = new THREE.Mesh(geometry, wireframeMaterial);
            wireframeMesh.castShadow = false;
            wireframeMesh.receiveShadow = false;
            logoGroup.add(wireframeMesh);
          });
        });
        
        // 所有形状添加完成后，将logo组添加到场景
        scene.add(logoGroup);
        
        // 在logo周围添加一些漂浮的光点（装饰）
        addFloatingParticles();
        
        console.log('✅ HCI Logo 3D模型加载成功！');
      },
      // 加载进度回调
      (xhr) => {
        if (xhr.total > 0) {
          const percent = Math.round((xhr.loaded / xhr.total) * 100);
          console.log(`加载SVG: ${percent}%`);
        }
      },
      // 错误回调
      (error) => {
        console.error('❌ 加载SVG失败:', error);
        // 如果加载失败，显示一个占位文本提示
        const errorDiv = document.createElement('div');
        errorDiv.style.position = 'absolute';
        errorDiv.style.top = '50%';
        errorDiv.style.left = '50%';
        errorDiv.style.transform = 'translate(-50%, -50%)';
        errorDiv.style.color = '#ff8888';
        errorDiv.style.backgroundColor = 'rgba(0,0,0,0.8)';
        errorDiv.style.padding = '20px 30px';
        errorDiv.style.borderRadius = '12px';
        errorDiv.style.fontSize = '18px';
        errorDiv.style.backdropFilter = 'blur(10px)';
        errorDiv.innerText = '⚠️ 无法加载 Logo 文件，请检查网络或URL';
        document.body.appendChild(errorDiv);
        
        // 仍然添加一个简单的占位几何体以保持场景生动
        const placeholderGeo = new THREE.TorusKnotGeometry(0.8, 0.25, 100, 16);
        const placeholderMat = new THREE.MeshStandardMaterial({ color: 0x4466aa, roughness: 0.3, metalness: 0.8 });
        const placeholder = new THREE.Mesh(placeholderGeo, placeholderMat);
        placeholder.castShadow = true;
        placeholder.receiveShadow = true;
        scene.add(placeholder);
      }
    );
    
    // 添加漂浮粒子装饰函数
    function addFloatingParticles() {
      const particleCount = 200;
      const particleGeo = new THREE.BufferGeometry();
      const particlePositions = new Float32Array(particleCount * 3);
      const particleColors = new Float32Array(particleCount * 3);
      
      const color1 = new THREE.Color(0x6688ff);
      const color2 = new THREE.Color(0xaa44ff);
      
      for (let i = 0; i < particleCount * 3; i += 3) {
        // 分布在logo周围球形区域
        const radius = 1.6 + Math.random() * 0.9;
        const theta = Math.random() * Math.PI * 2;
        const phi = Math.asin((Math.random() * 2) - 1);
        
        particlePositions[i] = Math.cos(theta) * Math.cos(phi) * radius;
        particlePositions[i+1] = Math.sin(phi) * radius * 0.9 + 0.2;
        particlePositions[i+2] = Math.sin(theta) * Math.cos(phi) * radius;
        
        const mixedColor = color1.clone().lerp(color2, Math.random());
        particleColors[i] = mixedColor.r;
        particleColors[i+1] = mixedColor.g;
        particleColors[i+2] = mixedColor.b;
      }
      
      particleGeo.setAttribute('position', new THREE.BufferAttribute(particlePositions, 3));
      particleGeo.setAttribute('color', new THREE.BufferAttribute(particleColors, 3));
      
      const particleMat = new THREE.PointsMaterial({
        size: 0.04,
        vertexColors: true,
        blending: THREE.AdditiveBlending,
        depthWrite: false,
        transparent: true,
        opacity: 0.7
      });
      
      const particles = new THREE.Points(particleGeo, particleMat);
      particles.name = 'floatingParticles';
      scene.add(particles);
    }

    // 添加一个简单的CSS标签漂浮在logo上方（使用CSS2D）
    const labelDiv = document.createElement('div');
    labelDiv.textContent = 'HCI';
    labelDiv.style.color = '#ccddff';
    labelDiv.style.fontSize = '20px';
    labelDiv.style.fontWeight = 'bold';
    labelDiv.style.letterSpacing = '3px';
    labelDiv.style.textShadow = '0 0 20px #3366ff';
    labelDiv.style.background = 'rgba(10,10,30,0.7)';
    labelDiv.style.padding = '4px 16px';
    labelDiv.style.borderRadius = '20px';
    labelDiv.style.backdropFilter = 'blur(5px)';
    
    const labelObj = new CSS2DObject(labelDiv);
    labelObj.position.set(0, 1.1, 0);
    scene.add(labelObj);

    // ---------- 动画循环 ----------
    function animate() {
      requestAnimationFrame(animate);
      
      // 星星缓慢旋转，增加动态感
      stars.rotation.y += 0.0001;
      stars.rotation.x += 0.00005;
      
      // 漂浮粒子旋转（如果存在）
      const floatingParticles = scene.getObjectByName('floatingParticles');
      if (floatingParticles) {
        floatingParticles.rotation.y += 0.002;
        floatingParticles.rotation.x = Math.sin(Date.now() * 0.0005) * 0.1;
      }
      
      // 光环缓慢旋转
      ring.rotation.z += 0.001;
      
      // 更新控制器
      controls.update();
      
      // 渲染主场景
      renderer.render(scene, camera);
      labelRenderer.render(scene, camera);
    }
    
    animate();
    
    // ---------- 窗口大小自适应 ----------
    window.addEventListener('resize', onWindowResize, false);
    function onWindowResize() {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
      labelRenderer.setSize(window.innerWidth, window.innerHeight);
    }
    
    console.log('🚀 3D场景初始化完成，尽情欣赏HCI Logo立体效果！');
  </script>
</body>
</html>